---
import BaseLayout from '@paobu/core/layouts/BaseLayout.astro';
import Icon from '@paobu/core/components/Icon.astro';
import { t, type Locale, LOCALES } from '@paobu/core/lib/i18n';
import { localePrefix, localeStaticParam } from '@paobu/core/lib/routing';
import { siteContent } from '../../../lib/content';
import { formatDistance, formatElevation, routeDetails, routeTypeLabel } from '../../../lib/view';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: localeStaticParam(locale) }, props: { locale } }));
}

const locale = Astro.props.locale as Locale;
const prefix = localePrefix(locale);
const content = siteContent();
const routes = content.visible('route');
const copy = locale === 'zh-CN'
  ? {
      eyebrow: '路线对比',
      title: '把赛道放在同一张表里',
      intro: '距离、爬升、类型、版本放在一起看。数字来自每条路线的固定版本；没有可信数字时写“未知”，不补估算。',
      flagship: '15 条旗舰主线',
      flagshipHint: '先看这 15 条，再决定要不要进入同一类型的其他赛道。',
      all: '全部路线',
      allHint: '按类型与距离排序，方便找同距离、同爬升或同地区的替代选项。',
      route: '路线',
      place: '地点',
      type: '类型',
      distance: '距离',
      climb: '爬升',
      version: '版本',
      open: '打开',
    }
  : {
      eyebrow: 'Route comparison',
      title: 'Put the courses in one table',
      intro: 'Distance, climb, type and version side by side. Numbers come from each route\'s fixed version; where there is no trustworthy number we write "unknown" rather than an estimate.',
      flagship: 'Fifteen flagship spines',
      flagshipHint: 'Start with these fifteen, then decide whether to enter another course of the same type.',
      all: 'All routes',
      allHint: 'Sorted by type and distance, to find alternatives at the same distance, climb or region.',
      route: 'Route',
      place: 'Place',
      type: 'Type',
      distance: 'Distance',
      climb: 'Climb',
      version: 'Version',
      open: 'Open',
    };
const flagship = ['boston', 'new-york', 'berlin', 'chicago', 'tokyo', 'london', 'shanghai', 'beijing', 'comrades-marathon', 'utmb', 'utnh', 'western-states', 'hardrock', 'hong-kong-100', 'utct'];
const typeOrder = ['road-marathon', 'road-ultra', 'trail-ultra', 'trail-mountain'];
const rows = routes.slice().sort((a, b) => {
  const da = routeDetails(a);
  const db = routeDetails(b);
  return typeOrder.indexOf(da.raceType) - typeOrder.indexOf(db.raceType)
    || (da.distanceMeters ?? 0) - (db.distanceMeters ?? 0);
});
const flagshipRows = rows.filter((route) => flagship.includes(route.slug));
const title = `${copy.title} · RUNUP`;
const description = copy.intro;
---

<BaseLayout locale={locale} title={title} description={description} active="routes" preview={content.preview} footerAd>
  <div class="page-shell">
    <div class="breadcrumbs">
      <ol>
        <li><a href={`${prefix}/`}>{locale === 'zh-CN' ? '首页' : 'Home'}</a></li>
        <li><a href={`${prefix}/routes/`}>{locale === 'zh-CN' ? '路线' : 'Routes'}</a></li>
        <li aria-current="page">{copy.eyebrow}</li>
      </ol>
    </div>

    <header class="page-intro">
      <span class="pill mint"><Icon name="route" size={14} />{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <section class="section" aria-labelledby="flagship-title">
      <div class="section-head">
        <div>
          <h2 id="flagship-title">{copy.flagship}</h2>
          <p>{copy.flagshipHint}</p>
        </div>
      </div>
      <div class="table-scroll compare-scroll">
        <table class="compare-table">
          <thead><tr><th>{copy.route}</th><th>{copy.place}</th><th>{copy.type}</th><th>{copy.distance}</th><th>{copy.climb}</th><th>{copy.version}</th></tr></thead>
          <tbody>
            {flagshipRows.map((route) => {
              const details = routeDetails(route);
              const translation = content.translation(route, locale);
              return (
                <tr>
                  <td><a href={`${prefix}/routes/${route.slug}/`}>{translation.title}</a></td>
                  <td>{details.placeName[locale]}</td>
                  <td>{routeTypeLabel(details.raceType, locale)}</td>
                  <td>{formatDistance(details.distanceMeters, locale)}</td>
                  <td>{formatElevation(details.elevationGainMeters, locale)}</td>
                  <td>{details.courseVersion ?? '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="all-title">
      <div class="section-head">
        <div>
          <h2 id="all-title">{copy.all}</h2>
          <p>{copy.allHint}</p>
        </div>
      </div>
      <div class="table-scroll compare-scroll">
        <table class="compare-table">
          <thead><tr><th>{copy.route}</th><th>{copy.place}</th><th>{copy.type}</th><th>{copy.distance}</th><th>{copy.climb}</th><th>{copy.version}</th></tr></thead>
          <tbody>
            {rows.map((route) => {
              const details = routeDetails(route);
              const translation = content.translation(route, locale);
              return (
                <tr>
                  <td><a href={`${prefix}/routes/${route.slug}/`}>{translation.title}</a></td>
                  <td>{details.placeName[locale]}</td>
                  <td>{routeTypeLabel(details.raceType, locale)}</td>
                  <td>{formatDistance(details.distanceMeters, locale)}</td>
                  <td>{formatElevation(details.elevationGainMeters, locale)}</td>
                  <td>{details.courseVersion ?? '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .compare-scroll { margin-top: 1rem; }
  .compare-table { width: 100%; min-width: 760px; border-collapse: collapse; }
  .compare-table th, .compare-table td { padding: .65rem .7rem; border-bottom: 1px solid var(--line, #d8ded2); text-align: left; vertical-align: top; }
  .compare-table th { font-size: .82rem; letter-spacing: .02em; color: var(--muted, #6c7566); }
  .compare-table td { font-size: .92rem; }
  .compare-table tr:hover td { background: var(--surface-2, #f6f8f2); }
</style>
