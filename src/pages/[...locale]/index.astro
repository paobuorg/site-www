---
import BaseLayout from '@paobu/core/layouts/BaseLayout.astro';
import Bean from '@paobu/core/components/Bean.astro';
import Icon from '@paobu/core/components/Icon.astro';
import SearchField from '@paobu/core/components/SearchField.astro';
import { t, type Locale, LOCALES } from '@paobu/core/lib/i18n';
import { localePrefix, localeStaticParam } from '@paobu/core/lib/routing';
import { siteContent } from '../../lib/content';
import { routeDetails } from '../../lib/view';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: localeStaticParam(locale) }, props: { locale } }));
}

const locale = Astro.props.locale as Locale;
const prefix = localePrefix(locale);
const content = siteContent();
const routes = content.visible('route');
const copy = locale === 'zh-CN'
  ? {
      eyebrow: '真实卫星地球 · 核验赛道',
      all: '全部',
      count: `${routes.length} 条已收录路线`,
      collections: '主题集合',
      selected: '已选择',
      open: '打开路线',
      imagery: '底图：NASA Blue Marble 卫星影像合成',
      rotate: '自动旋转',
      rotateHint: '点击开始或暂停旋转',
      startGlobe: '打开 3D 地球',
      startGlobeHint: '先看静态地球，点击后再加载卫星影像与路线点',
    }
  : {
      eyebrow: 'Real satellite Earth · verified courses',
      all: 'All',
      count: `${routes.length} catalogued routes`,
      collections: 'Collections',
      selected: 'Selected',
      open: 'Open route',
      imagery: 'Base imagery: NASA Blue Marble composite',
      rotate: 'Auto rotate',
      rotateHint: 'Start or pause rotation',
      startGlobe: 'Open the 3D globe',
      startGlobeHint: 'Static globe first; load imagery and route points only when you click',
    };
const globeRoutes = routes.map((route) => {
  const details = routeDetails(route);
  const translation = content.translation(route, locale);
  return {
    id: route.entityId,
    kind: details.raceType,
    title: translation.title,
    place: details.placeName[locale],
    url: `${prefix}/routes/${route.slug}/`,
    longitude: details.mapAnchor.longitude,
    latitude: details.mapAnchor.latitude,
  };
});
const title = locale === 'zh-CN' ? '跑起来 RUNUP · 经典赛道与卫星地球' : 'RUNUP · Classic courses and a satellite Earth';
const description = locale === 'zh-CN'
  ? '在真实卫星地球上探索经核验的马拉松与越野赛道，阅读来源透明的跑步知识与可解释的计算工具。'
  : 'Explore verified marathon and trail courses on a real satellite Earth, with traceable running knowledge and explainable calculators.';
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  active="routes"
  preview={content.preview}
  bodyClass="page-globe"
  footerAd
>
  <Fragment slot="head">
  </Fragment>

  <section class="globe-home" aria-labelledby="globe-title">
    <div class="globe-stage" data-globe-stage>
      <div class="globe-poster">
        <div class="poster-sphere"></div>
        <button class="globe-start" type="button" data-globe-start aria-label={`${copy.startGlobe}，${copy.startGlobeHint}`}>
          <Icon name="globe" size={18} />
          <span>{copy.startGlobe}</span>
        </button>
      </div>
      <div class="globe-loading" hidden>
        <span class="spinner" aria-hidden="true"></span>
        <span class="sr-only">{t(locale, 'noGlobeLoading')}</span>
      </div>
      <div class="globe-fallback" hidden>
        <div>
          <Bean expression="tired" size={88} className="fallback-mascot" label={locale === 'zh-CN' ? '豆客没能打开地球' : 'Douke could not open the globe'} />
          <p>{t(locale, 'noGlobe')}</p>
        </div>
      </div>

      <div class="globe-controls">
        <button
          class="icon-button"
          type="button"
          data-globe-rotate
          aria-pressed="false"
          aria-label={copy.rotate}
          title={copy.rotateHint}
        >
          <Icon name="refresh" size={20} />
        </button>
        <button class="icon-button" type="button" data-globe-zoom-in aria-label={t(locale, 'zoomIn')}>
          <Icon name="plus" size={20} />
        </button>
        <button class="icon-button" type="button" data-globe-zoom-out aria-label={t(locale, 'zoomOut')}>
          <Icon name="minus" size={20} />
        </button>
        <button class="icon-button" type="button" data-globe-reset aria-label={t(locale, 'resetView')}>
          <Icon name="globe" size={20} />
        </button>
      </div>

      <div class="globe-legend" aria-hidden="true">
        <span><i class="legend-dot"></i>{t(locale, 'road')}</span>
        <span><i class="legend-dot"></i>{t(locale, 'roadUltra')}</span>
        <span><i class="legend-dot trail"></i>{t(locale, 'trail')}</span>
      </div>

      <div class="globe-selected" data-globe-selected hidden>
        <Icon name="pin" size={22} />
        <div class="globe-selected-text">
          <strong data-selected-title></strong>
          <span data-selected-meta></span>
        </div>
        <a class="button small primary" href="#" data-selected-link>{copy.open}</a>
        <button class="icon-button" type="button" data-globe-close aria-label={t(locale, 'close')}>
          <Icon name="close" size={18} />
        </button>
      </div>

      <p class="globe-data-credit">
        {copy.imagery} · <a href="https://science.nasa.gov/earth/earth-observatory/blue-marble-next-generation/" rel="external noopener">NASA</a>
      </p>
    </div>

    <aside class="globe-panel" aria-labelledby="globe-title">
      <button class="globe-mobile-handle" type="button" aria-label={t(locale, 'openSheet')} data-sheet-toggle></button>
      <span class="pill mint"><Icon name="globe" size={14} />{copy.eyebrow}</span>
      <h1 id="globe-title">{t(locale, 'routeHome')}</h1>
      <p class="globe-subtitle">{t(locale, 'routeSubtitle')}</p>
      <SearchField locale={locale} action={`${prefix}/search/`} id="route-search-input" placeholder={t(locale, 'routeSearch')} />

      <div class="filter-row" role="group" aria-label={locale === 'zh-CN' ? '按类型筛选' : 'Filter by type'}>
        <button class="filter-chip" type="button" data-route-filter="all" aria-pressed="true">{copy.all}</button>
        <button class="filter-chip road" type="button" data-route-filter="road-marathon" aria-pressed="false">
          <span class="legend-dot"></span>{t(locale, 'road')}
        </button>
        <button class="filter-chip road" type="button" data-route-filter="road-ultra" aria-pressed="false">
          <span class="legend-dot"></span>{t(locale, 'roadUltra')}
        </button>
        <button class="filter-chip trail" type="button" data-route-filter="trail-ultra" aria-pressed="false">
          <span class="legend-dot trail"></span>{t(locale, 'trail')}
        </button>
        <button class="filter-chip trail" type="button" data-route-filter="trail-mountain" aria-pressed="false">
          <span class="legend-dot trail"></span>{t(locale, 'mountain')}
        </button>
      </div>

      <div class="route-list" data-globe-routes={JSON.stringify(globeRoutes)}>
        {routes.map((route) => {
          const details = routeDetails(route);
          const translation = content.translation(route, locale);
          return (
            <a
              class="route-list-item"
              href={`${prefix}/routes/${route.slug}/`}
              data-route-card
              data-route-kind={details.raceType}
            >
              <span class:list={['route-list-thumb', details.raceType !== 'road-marathon' && details.raceType !== 'road-ultra' && 'trail']} aria-hidden="true"></span>
              <span class="route-list-content">
                <strong>{translation.title}</strong>
                <span>{details.placeName[locale]}</span>
              </span>
              <span class="route-list-arrow"><Icon name="chevron-right" size={17} /></span>
            </a>
          );
        })}
      </div>

      <div class="globe-panel-footer">
        <span>{copy.count}</span>
        <span class="footer-links"><a href={`${prefix}/routes/`}>{t(locale, 'allRoutes')} →</a><a href={`${prefix}/compare/`}>{locale === 'zh-CN' ? '对比' : 'Compare'} →</a><a href={`${prefix}/calendar/`}>{locale === 'zh-CN' ? '2027 赛历' : '2027 calendar'} →</a><a href={`${prefix}/collections/`}>{copy.collections} →</a></span>
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  import { ensureCesiumStyles, initHomeGlobe } from '../../client/globe';
  let globeStarted = false;
  const startGlobe = () => {
    if (globeStarted) return;
    globeStarted = true;
    const button = document.querySelector<HTMLButtonElement>('[data-globe-start]');
    const loading = document.querySelector<HTMLElement>('.globe-loading');
    const stage = document.querySelector<HTMLElement>('[data-globe-stage]');
    button?.setAttribute('hidden', '');
    if (loading) loading.hidden = false;
    stage?.classList.add('is-globe-active');
    ensureCesiumStyles();
    void initHomeGlobe();
  };
  document.querySelector('[data-globe-start]')?.addEventListener('click', startGlobe, { once: true });

  const autoEligible = () => {
    if (!window.matchMedia('(min-width: 900px)').matches) return false;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    const hints = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
    if (hints.connection?.saveData) return false;
    return !(typeof hints.deviceMemory === 'number' && hints.deviceMemory > 0 && hints.deviceMemory <= 2);
  };
  const scheduleGlobe = () => {
    if (!autoEligible()) return;
    window.setTimeout(() => { if (!globeStarted) startGlobe(); }, 3000);
  };
  if (document.readyState === 'complete') scheduleGlobe();
  else window.addEventListener('load', scheduleGlobe, { once: true });

  const panel = document.querySelector('.globe-panel');
  document.querySelector('[data-sheet-toggle]')?.addEventListener('click', () => {
    const expanded = panel?.classList.toggle('is-expanded') ?? false;
    document.querySelector('[data-sheet-toggle]')?.setAttribute(
      'aria-label',
      expanded ? '收起列表' : '展开路线列表',
    );
  });
</script>

<style>
  /* .poster-sphere base styles live in @paobu/core components.css. */

  .globe-poster .poster-sphere {
    background-image: url('/textures/earth-blue-marble-1024.jpg');
  }
  .globe-poster::after { pointer-events: none; }
  .poster-sphere { pointer-events: none; }
  .globe-start {
    position: absolute;
    left: 55%;
    top: 72%;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 999px;
    background: rgba(8, 20, 36, .72);
    color: #fff;
    font: inherit;
    font-size: .86rem;
    font-weight: 650;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transform: translate(-50%, -50%);
  }
  .globe-start:hover { background: rgba(8, 184, 157, .82); }
  .globe-start[hidden] { display: none; }
  .globe-controls { opacity: 0; pointer-events: none; }
  .globe-stage.is-globe-active .globe-controls { opacity: 1; pointer-events: auto; }
  @media (max-width: 900px) {
    .globe-start { left: 50%; top: 68%; }
  }
</style>
