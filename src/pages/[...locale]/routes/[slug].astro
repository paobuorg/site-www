  }),
];
const anchorLabel = details.mapAnchor.kind === 'start' ? copy.anchorStart : copy.anchorOverview;
const relatedKnowledge = related.filter((item) => item.kind === 'knowledge');
const relatedTools = related.filter((item) => item.kind === 'tool');
const relatedRoutes = related.filter((item) => item.kind === 'route');
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  active="routes"
  preview={content.preview}
  ogType="article"
  alternateHref={`${localePrefix(other)}/routes/${entity.slug}/`}
  structuredData={structuredData}
  modifiedTime={entity.updatedAt}
  footerAd
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/cesium/Widgets/widgets.css" />
    <link rel="preload" as="image" href="/textures/earth-blue-marble-2048.jpg" />
  </Fragment>

  <div class="page-shell">
    <div class="breadcrumbs">
      <ol>
        <li><a href={`${prefix}/`}>{copy.home}</a></li>
        <li><a href={`${prefix}/routes/`}>{copy.allRoutes}</a></li>
        <li>{translation.title}</li>
      </ol>
    </div>

    <div class="route-detail-layout">
      <div class="route-map-card">
        <div
          class="globe-stage"
          data-route-globe
          data-longitude={details.mapAnchor.longitude}
          data-latitude={details.mapAnchor.latitude}
          data-title={mapLabel}
          data-kind={details.raceType}
        >
          <div class="globe-poster" aria-hidden="true">
            <div class="poster-sphere route-poster-sphere"></div>
          </div>
          <div class="globe-loading">
            <span class="spinner" aria-hidden="true"></span>
            <span class="sr-only">{t(locale, 'noGlobeLoading')}</span>
          </div>
          <div class="route-map-fallback" hidden>
            <div>
              <Icon name="globe" size={44} />
              <p>
                {locale === 'zh-CN'
                  ? '当前设备或网络设置无法显示交互地图，赛道信息与来源仍可在下方阅读。'
                  : 'Interactive map is unavailable on this device or data setting. Route facts and sources remain readable below.'}
              </p>
            </div>
          </div>
          <div class="globe-controls">
            <button class="icon-button" type="button" data-globe-zoom-in aria-label={t(locale, 'zoomIn')}>
              <Icon name="plus" size={20} />
            </button>
            <button class="icon-button" type="button" data-globe-zoom-out aria-label={t(locale, 'zoomOut')}>
              <Icon name="minus" size={20} />
            </button>
            <button class="icon-button" type="button" data-globe-reset aria-label={t(locale, 'resetView')}>
              <Icon name="globe" size={20} />
            </button>
          </div>
          <p class="globe-data-credit">
            {locale === 'zh-CN'
              ? '底图：NASA Blue Marble 卫星影像合成；近景（可用时）：EOX Sentinel-2 cloudless 公开瓦片'
              : 'Base imagery: NASA Blue Marble composite; close-up when available: EOX Sentinel-2 cloudless public tiles'} ·{' '}
            <a href="https://science.nasa.gov/earth/earth-observatory/blue-marble-next-generation/" rel="external noopener">NASA</a>
            {' · '}
            <a href="https://s2maps.eu" rel="external noopener">Sentinel-2 cloudless</a>
            {' · '}
            <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="external noopener license">CC BY-NC-SA 4.0</a>
          </p>
        </div>
      </div>

      <aside class="card route-info-card" aria-labelledby="route-title">
        <div class="route-type">
          <span class:list={['pill', details.raceType === 'road-marathon' || details.raceType === 'road-ultra' ? 'blue' : 'yellow']}>
            <Icon name={details.raceType === 'road-marathon' || details.raceType === 'road-ultra' ? 'route' : 'mountain'} size={14} />
            {routeTypeLabel(details.raceType, locale)}
          </span>
          <span class="pill lavender">{anchorLabel}</span>
          {entity.status !== 'published' && <span class="pill coral">{copy.previewStatus}</span>}
        </div>
        <h1 id="route-title">{translation.title}</h1>
        <p class="route-place">{details.placeName[locale]}</p>

        <dl class="stat-grid">
          <div class="stat">
            <dt>{t(locale, 'distance')}</dt>
            <dd>{formatDistance(details.distanceMeters, locale)}</dd>
          </div>
          <div class="stat">
            <dt>{t(locale, 'elevation')}</dt>
            <dd>{formatElevation(details.elevationGainMeters, locale)}</dd>
          </div>
        </dl>

        <dl class="route-facts">
          <div>
            <dt>{t(locale, 'courseVersion')}</dt>
            <dd>{details.courseVersion}</dd>
          </div>
          <div>
            <dt>{t(locale, 'direction')}</dt>
            <dd>{details.direction}</dd>
          </div>
          <div>
            <dt>{t(locale, 'country')}</dt>
            <dd>{details.countryCodes.join(' · ')}</dd>
          </div>
          <div>
            <dt>{copy.mapAnchor}</dt>
            <dd>{sources.find((source) => source.sourceId === details.mapAnchor.sourceRef)?.publisher ?? details.mapAnchor.sourceRef}</dd>
          </div>
          <div>
            <dt>{t(locale, 'updatedOn')}</dt>
            <dd>{formatDate(entity.updatedAt, locale)}</dd>
          </div>
        </dl>

        <p class="field-hint">{details.geometryAccess === 'unavailable'
          ? copy.geometryUnavailable
          : details.geometryAccess === 'official-link'
            ? copy.geometryOfficial
            : copy.geometryRedistributable}</p>
        {officialHref && (
          <a class="button primary wide" href={officialHref} rel="external noopener">
            <Icon name="external" size={17} />{officialLabel}
          </a>
        )}
      </aside>
    </div>

    <div class={`route-narrative${entity.slug === 'ccc' ? ' ccc-narrative' : ''}${entity.slug === 'canyons' ? ' canyons-narrative' : ''}${entity.slug === 'tarawera' ? ' tarawera-narrative' : ''}${entity.slug === 'sdw100' ? ' sdw100-narrative' : ''}${entity.slug === 'hong-kong-100' ? ' hongkong100-narrative' : ''}${entity.slug === 'occ' ? ' occ-narrative' : ''}${entity.slug === 'ultra-trail-australia' ? ' uta-narrative' : ''}${entity.slug === 'mt-fuji-100' ? ' mtfuji-narrative' : ''}${entity.slug === 'doi-inthanon-pagoda-50-day' ? ' doi-narrative' : ''}${entity.slug === 'kodiak' ? ' kodiak-narrative' : ''}${entity.slug === 'black-canyon-ultras' ? ' blackcanyon-narrative' : ''}${entity.slug === 'beijing' ? ' beijing-narrative' : ''}${entity.slug === 'wildstrubel' ? ' wildstrubel-narrative' : ''}${entity.slug === 'val-daran' ? ' val-daran-narrative' : ''}${entity.slug === 'gpt100-miler' ? ' gpt100-narrative' : ''}${entity.slug === 'paraty-brazil' ? ' paraty-narrative' : ''}${entity.slug === 'chiang-dao-160' ? ' chiang-dao-narrative' : ''}${entity.slug === 'buenos-aires' ? ' buenos-aires-narrative' : ''}${entity.slug === 'vmm-100' ? ' vmm-100-narrative' : ''}`}>
      {entity.status !== 'published' && (
        <div class="notice tone-yellow">
          <Icon name="alert" size={18} />
          <div>
            <strong>{copy.previewStatus}</strong>
            <p>{copy.reviewNote}</p>
          </div>
        </div>
      )}

      <h2>{t(locale, 'sections')}</h2>
      <div class="prose" set:html={bodyHtml} />

      <div class="route-version-box">
        <strong>{copy.versionTitle}</strong>
        <span>{copy.edition}: {details.courseEdition ?? copy.unknown} · {copy.status[details.courseStatus ?? 'unknown']}</span>
        <span>{t(locale, 'courseVersion')}: {details.courseVersion}</span>
        <span>{copy.reviewDue}: {formatDate(entity.reviewDueAt, locale)}</span>
        {details.courseChanges?.length ? (
          <div>
            <span>{copy.changesTitle}</span>
            <ul>
              {details.courseChanges.map((change) => (
                <li>{change.edition} · {change.note[locale]}</li>
              ))}
            </ul>
          </div>
        ) : null}
        <span>{copy.distanceMethod}: {details.distanceMethod}</span>
        <span>{copy.elevationMethod}: {details.elevationMethod ?? copy.unknown}</span>
        <span>{copy.authors}: {authors.join(', ')}</span>
        <span>{copy.checked}: {formatDate(entity.reviewedAt, locale)}</span>
      </div>

      <div class="route-footer-grid">
        <div class="route-sources">
          <h2>{t(locale, 'sourcesHeading')}</h2>
          <div class="source-list">
            {sources.map((source, index) => (
              <div class="source-item">
                <a href={source.url} rel="external noopener">{source.title} <Icon name="external" size={14} /></a>
                <p>{source.claims.join(' ')}</p>
                {sourceNotes[index] ? <p class="source-meta source-verification">{sourceNotes[index]}</p> : null}
                <p class="source-meta">
                  {source.publisher}
                  {source.publishedAt ? ` · ${formatDate(source.publishedAt, locale)}` : ''}
                  {' · '}{copy.access} {formatDate(source.accessedAt, locale)}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="route-related">
          <h2>{t(locale, 'related')}</h2>
          {relatedKnowledge.length > 0 && (
            <>
              <p class="field-hint">{copy.relatedKnowledge}</p>
              <div class="related-row">
                {relatedKnowledge.map((item) => (
                  <a class="related-link" href={entityHref(item, locale)} data-cross-site>
                    <Icon name="book" size={17} />
                    <span>{content.translation(item, locale).title}</span>
                  </a>
                ))}
              </div>
            </>
          )}
          {relatedTools.length > 0 && (
            <>
              <p class="field-hint">{copy.relatedTools}</p>
              <div class="related-row">
                {relatedTools.map((item) => (
                  <a class="related-link" href={entityHref(item, locale)} data-cross-site>
                    <Icon name="tools" size={17} />
                    <span>{content.translation(item, locale).title}</span>
                  </a>
                ))}
              </div>
            </>
          )}
          {relatedRoutes.length > 0 && (
            <>
              <p class="field-hint">{copy.relatedRoutes}</p>
              <div class="related-row">
                {relatedRoutes.map((item) => (
                  <a class="related-link" href={entityHref(item, locale)}>
                    <Icon name="route" size={17} />
                    <span>{content.translation(item, locale).title}</span>
                  </a>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
      <LegalNotice locale={locale} context="route" />
    </div>
  </div>
</BaseLayout>

<script>
  import { initRouteGlobe } from '../../../client/globe';
  initRouteGlobe();
</script>

<style>
  .route-poster-sphere {
    top: 54%;
    left: 56%;
    width: min(74%, 70vh);
    background-position: 50% 44%;
  }

  @media (max-width: 900px) {
    .route-poster-sphere {
      width: min(82%, 56vh);
    }
  }
</style>

<style is:global>
  .prose table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }

  .table-scroll {
    min-width: 0;
    max-width: 100%;
    margin-bottom: 1.15em;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-scroll table {
    display: table;
    width: max-content;
    min-width: 100%;
    margin-bottom: 0;
  }

  .tarawera-narrative .tarawera-checkpoint-table table {
    width: 100%;
    table-layout: fixed;
    font-size: 0.86rem;
  }

  .tarawera-narrative .tarawera-checkpoint-table th,
  .tarawera-narrative .tarawera-checkpoint-table td {
    padding-left: 6px;
    padding-right: 6px;
    overflow-wrap: normal;
  }

  .tarawera-narrative .tarawera-checkpoint-table th {
    padding-left: 4px;
    padding-right: 4px;
    font-size: 0.70rem;
    line-height: 1.2;
    overflow-wrap: normal;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(1),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(1) {
    width: 16%;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(2),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(2) {
    width: 6%;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(3),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(3),
  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(4),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(4),
  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(5),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(5) {
    width: 9%;
  }

  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(2),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(3),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(4),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(5) {
    white-space: nowrap;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(6),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(6) {
    width: 9%;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(7),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(7) {
    width: 11%;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(8),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(8) {
    width: 8%;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(9),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(9) {
    width: 8%;
  }

  .tarawera-narrative .tarawera-checkpoint-table th:nth-child(10),
  .tarawera-narrative .tarawera-checkpoint-table td:nth-child(10) {
    width: 15%;
  }

  .sdw100-narrative .sdw100-aid-table table,
  .sdw100-narrative .sdw100-split-table table,
  .sdw100-narrative .sdw100-conflict-table table {
    width: 100%;
    table-layout: fixed;
    font-size: 0.86rem;
  }

  .sdw100-narrative .sdw100-aid-table th,
  .sdw100-narrative .sdw100-aid-table td,
  .sdw100-narrative .sdw100-split-table th,
  .sdw100-narrative .sdw100-split-table td,
  .sdw100-narrative .sdw100-conflict-table th,
  .sdw100-narrative .sdw100-conflict-table td {
    padding-left: 6px;
    padding-right: 6px;
    overflow-wrap: normal;
  }

  .sdw100-narrative .sdw100-aid-table th,
  .sdw100-narrative .sdw100-split-table th,
  .sdw100-narrative .sdw100-conflict-table th {
    font-size: 0.72rem;
    line-height: 1.2;
    overflow-wrap: normal;
  }

  .sdw100-narrative .sdw100-aid-table th:nth-child(1),
  .sdw100-narrative .sdw100-aid-table td:nth-child(1) {
    width: 28%;
  }

  .sdw100-narrative .sdw100-aid-table th:nth-child(2),
  .sdw100-narrative .sdw100-aid-table td:nth-child(2) {
    width: 7%;
  }

  .sdw100-narrative .sdw100-aid-table th:nth-child(3),
  .sdw100-narrative .sdw100-aid-table td:nth-child(3),
  .sdw100-narrative .sdw100-aid-table th:nth-child(4),
  .sdw100-narrative .sdw100-aid-table td:nth-child(4) {
    width: 15%;
  }

  .sdw100-narrative .sdw100-aid-table th:nth-child(5),
  .sdw100-narrative .sdw100-aid-table td:nth-child(5) {
    width: 35%;
    text-align: left;
  }

  .sdw100-narrative .sdw100-aid-table td:nth-child(2),
  .sdw100-narrative .sdw100-aid-table td:nth-child(3),
  .sdw100-narrative .sdw100-aid-table td:nth-child(4),
  .sdw100-narrative .sdw100-aid-table td:nth-child(5) {
    white-space: nowrap;
  }

  .sdw100-narrative .sdw100-split-table th:nth-child(1),
  .sdw100-narrative .sdw100-split-table td:nth-child(1) {
    width: 20%;
  }

  .sdw100-narrative .sdw100-split-table th:nth-child(2),
  .sdw100-narrative .sdw100-split-table td:nth-child(2),
  .sdw100-narrative .sdw100-split-table th:nth-child(3),
  .sdw100-narrative .sdw100-split-table td:nth-child(3) {
    width: 9%;
  }

  .sdw100-narrative .sdw100-split-table th:nth-child(4),
  .sdw100-narrative .sdw100-split-table td:nth-child(4) {
    width: 17%;
  }

  .sdw100-narrative .sdw100-split-table th:nth-child(5),
  .sdw100-narrative .sdw100-split-table td:nth-child(5) {
    width: 22%;
  }

  .sdw100-narrative .sdw100-split-table th:nth-child(6),
  .sdw100-narrative .sdw100-split-table td:nth-child(6) {
    width: 23%;
  }

  .sdw100-narrative .sdw100-split-table td:nth-child(2),
  .sdw100-narrative .sdw100-split-table td:nth-child(3),
  .sdw100-narrative .sdw100-split-table td:nth-child(4),
  .sdw100-narrative .sdw100-split-table td:nth-child(5),
  .sdw100-narrative .sdw100-split-table td:nth-child(6) {
    white-space: nowrap;
  }

  .sdw100-narrative .sdw100-conflict-table th:nth-child(1),
  .sdw100-narrative .sdw100-conflict-table td:nth-child(1) {
    width: 26%;
  }

  .sdw100-narrative .sdw100-conflict-table th:nth-child(2),
  .sdw100-narrative .sdw100-conflict-table td:nth-child(2),
  .sdw100-narrative .sdw100-conflict-table th:nth-child(3),
  .sdw100-narrative .sdw100-conflict-table td:nth-child(3) {
    width: 37%;
  }

  .prose code {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 430px) {
    .ccc-narrative .table-scroll table {
      font-size: 0.82rem;
    }

    .ccc-narrative .table-scroll th,
    .ccc-narrative .table-scroll td {
      padding: 6px 5px;
    }

    .ccc-narrative .ccc-timing-table {
      overflow-x: visible;
    }

    .ccc-narrative .ccc-timing-table table {
      display: block;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      font-size: 0.84rem;
    }

    .ccc-narrative .ccc-timing-table thead {
      display: none;
    }

    .ccc-narrative .ccc-timing-table tbody {
      display: grid;
      gap: 10px;
    }

    .ccc-narrative .ccc-timing-table tr {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 7px 10px;
      padding: 12px 13px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface-2);
    }

    .ccc-narrative .ccc-timing-table td {
      display: block;
      padding: 0;
      border: 0;
      background: none;
      white-space: normal;
      text-align: left;
      line-height: 1.45;
      font-variant-numeric: tabular-nums;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(1) {
      grid-column: 1 / span 1;
      grid-row: 1;
      color: var(--primary-text);
      font-weight: 800;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(2) {
      grid-column: 2 / -1;
      grid-row: 1;
      font-weight: 750;
      font-size: 0.94rem;
      overflow-wrap: anywhere;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(3),
    .ccc-narrative .ccc-timing-table td:nth-child(5),
    .ccc-narrative .ccc-timing-table td:nth-child(7) {
      grid-column: 1 / span 4;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(4),
    .ccc-narrative .ccc-timing-table td:nth-child(6),
    .ccc-narrative .ccc-timing-table td:nth-child(8) {
      grid-column: 5 / span 4;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(3) {
      grid-row: 2;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(4) {
      grid-row: 2;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(5) {
      grid-row: 3;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(6) {
      grid-row: 3;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(7) {
      grid-row: 4;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(8) {
      grid-row: 4;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(n + 3)::before {
      display: block;
      margin-bottom: 1px;
      color: var(--muted);
      font-size: 0.66rem;
      font-weight: 620;
      letter-spacing: 0.04em;
      line-height: 1.3;
    }

    .ccc-narrative .ccc-timing-table td:nth-child(3)::before {
      content: "累计距离";
    }

    .ccc-narrative .ccc-timing-table td:nth-child(4)::before {
      content: "段距离";
    }

    .ccc-narrative .ccc-timing-table td:nth-child(5)::before {
      content: "段爬升 / 下降";
    }

    .ccc-narrative .ccc-timing-table td:nth-child(6)::before {
      content: "累计爬升 / 下降";
    }

    .ccc-narrative .ccc-timing-table td:nth-child(7)::before {
      content: "海拔";
    }

    .ccc-narrative .ccc-timing-table td:nth-child(8)::before {
      content: "关门";
    }

    :lang(en) .ccc-narrative .ccc-timing-table td:nth-child(3)::before {
      content: "Cum. distance";
    }

    :lang(en) .ccc-narrative .ccc-timing-table td:nth-child(4)::before {
      content: "Seg. distance";
    }

    :lang(en) .ccc-narrative .ccc-timing-table td:nth-child(5)::before {
      content: "Seg. gain / loss";
