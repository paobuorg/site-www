---
import BaseLayout from '@paobu/core/layouts/BaseLayout.astro';
import Bean from '@paobu/core/components/Bean.astro';
import Icon from '@paobu/core/components/Icon.astro';
import { t, type Locale, LOCALES } from '@paobu/core/lib/i18n';
import { localePrefix, localeStaticParam } from '@paobu/core/lib/routing';
import { siteContent } from '../../../lib/content';
import { formatDistance, formatElevation, routeDetails } from '../../../lib/view';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: localeStaticParam(locale) }, props: { locale } }));
}

const locale = Astro.props.locale as Locale;
const prefix = localePrefix(locale);
const content = siteContent();
const routes = content.visible('route');
const copy = locale === 'zh-CN'
  ? {
      title: '全部路线',
      intro: '每条赛道固定一个可核验版本，并明确标注距离、爬升口径与轨迹权利。没有可信数据时，我们宁可留空，也不编造数字。',
      roadmap: '公路马拉松',
      roadUltra: '公路超马',
      trail: '越野超马',
      mountain: '山地竞速',
      version: '版本',
      noGeometry: '无本站轨迹',
      empty: '目前没有可显示的路线。',
      collections: '按主题浏览',
      collectionsHint: '把赛道按训练或执行问题分组，而不是按洲际堆列表。',
    }
  : {
      title: 'All routes',
      intro: 'Each course pins a verifiable version and states its distance, elevation method and track rights. When data is not trustworthy, we leave it blank rather than invent a number.',
      roadmap: 'Road marathons',
      roadUltra: 'Road ultras',
      trail: 'Trail ultras',
      mountain: 'Mountain races',
      version: 'Version',
      noGeometry: 'No bundled track',
      empty: 'No routes are available to show.',
      collections: 'Browse by theme',
      collectionsHint: 'Courses grouped by the training or execution question they share, not by continent.',
    };
const title = `${copy.title} · RUNUP`;
const sections = [
  { type: 'road-marathon', label: copy.roadmap },
  { type: 'road-ultra', label: copy.roadUltra },
  { type: 'trail-ultra', label: copy.trail },
  { type: 'trail-mountain', label: copy.mountain },
];
const description = locale === 'zh-CN'
  ? '浏览跑起来收录的马拉松与越野赛道档案，查看固定版本、来源与轨迹权利状态。'
  : 'Browse the marathon and trail course archive on RunUp, with fixed versions, sources and track-rights status.';
---

<BaseLayout locale={locale} title={title} description={description} active="routes" preview={content.preview} footerAd>
  <div class="page-shell">
    <div class="breadcrumbs">
      <ol>
        <li><a href={`${prefix}/`}>{t(locale, 'home')}</a></li>
        <li>{copy.title}</li>
      </ol>
    </div>
    <div class="page-intro">
      <div>
        <span class="pill blue"><Icon name="route" size={14} />{t(locale, 'routeSubtitle')}</span>
        <h1>{copy.title}</h1>
        <p>{copy.intro}</p>
      <div class="filter-row"><a class="button small ghost" href={`${prefix}/compare/`}>{locale === 'zh-CN' ? '对比全部路线' : 'Compare all routes'} →</a><a class="button small" href={`${prefix}/calendar/`}>{locale === 'zh-CN' ? '看 2027 赛历' : '2027 calendar'} →</a></div>
      </div>
      <Bean expression="map" size={126} className="intro-mascot" label={locale === 'zh-CN' ? '豆客在看路线' : 'Douke checking the route'} />
    </div>

    <div class="collection-strip">
      <div>
        <h2>{copy.collections}</h2>
        <p class="field-hint">{copy.collectionsHint}</p>
      </div>
      <a class="button small" href={`${prefix}/collections/`}>{copy.collections} →</a>
    </div>

    {routes.length === 0 ? (
      <div class="empty-state">
        <Icon name="route" size={44} />
        <h2>{copy.empty}</h2>
      </div>
    ) : (
      <>
        {sections.map((section) => (
          <Fragment>
            <div class="section-heading"><h2>{section.label}</h2></div>
            <div class="grid two">
              {routes.filter((route) => routeDetails(route).raceType === section.type).map((route) => {
                const details = routeDetails(route);
                const translation = content.translation(route, locale);
                const isRoad = section.type === 'road-marathon' || section.type === 'road-ultra';
                return (
                  <article class:list={['card', 'route-card', !isRoad && 'trail', isRoad && 'hoverable']}>
                    <div class="route-card-media">
                      <div class="route-flag">
                        <span class:list={['pill', isRoad ? 'mint' : 'yellow']}>{section.label}</span>
                        <span class="distance-badge">{formatDistance(details.distanceMeters, locale)}</span>
                      </div>
                      <Icon name={isRoad ? 'route' : 'mountain'} size={42} class="route-glyph" />
                    </div>
                    <div class="route-card-body">
                      <h3>{translation.title}</h3>
                      <p class="route-subtitle">{details.placeName[locale]}</p>
                      <div class="route-card-meta">
                        <span class="pill">{details.countryCodes.join(' · ')}</span>
                        {isRoad ? (
                          <>
                            <span class="pill lavender">{copy.version} {details.courseVersion}</span>
                            {section.type === 'road-ultra' && <span class="pill yellow">{t(locale, 'elevation')} {formatElevation(details.elevationGainMeters, locale)}</span>}
                            {details.geometryAccess === 'unavailable' && <span class="pill coral">{copy.noGeometry}</span>}
                          </>
                        ) : (
                          <span class="pill yellow">{t(locale, 'elevation')} {formatElevation(details.elevationGainMeters, locale)}</span>
                        )}
                      </div>
                      <div class="route-card-actions">
                        <a class="button small primary" href={`${prefix}/routes/${route.slug}/`}>{t(locale, 'viewRoute')}</a>
                        <span class="arrow">→</span>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </Fragment>
        ))}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .collection-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 30px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface-2);
  }

  .collection-strip h2 {
    margin: 0 0 4px;
    font-size: 1.05rem;
  }

  .collection-strip .field-hint {
    margin: 0;
  }

  .intro-mascot {
    width: 126px;
    height: 126px;
    flex: 0 0 auto;
  }

  @media (max-width: 767px) {
    .intro-mascot {
      width: 88px;
      height: 88px;
      margin-top: 16px;
    }
  }
</style>
