---
import BaseLayout from '@paobu/core/layouts/BaseLayout.astro';
import Bean from '@paobu/core/components/Bean.astro';
import Icon from '@paobu/core/components/Icon.astro';
import { t, type Locale, LOCALES } from '@paobu/core/lib/i18n';
import { localePrefix, localeStaticParam } from '@paobu/core/lib/routing';
import { githubUrl } from '@paobu/core/lib/sites';
import { siteContent } from '../../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: localeStaticParam(locale) }, props: { locale } }));
}

const locale = Astro.props.locale as Locale;
const prefix = localePrefix(locale);
const content = siteContent();
const gh = githubUrl();
const copy = locale === 'zh-CN'
  ? {
      title: '关于与方法',
      lead: '跑起来把三件事放在一起：可核验的经典赛道、可追溯的跑步知识、可解释的计算工具。我们不把“看起来专业”当作证据。',
      mascotEyebrow: '认识豆客',
      mascotTitle: '一颗会跑步的豆子',
      mascotBody: '豆客是跑起来的引路员。它不替你训练，也不替你下结论；它出现在路口、书页和工具旁边，用表情提示当前场景。',
      mascotExpressions: [
        { expression: 'run', label: '出发' },
        { expression: 'wave', label: '打招呼' },
        { expression: 'map', label: '看路线' },
        { expression: 'book', label: '读一页' },
        { expression: 'tool', label: '算一算' },
        { expression: 'search', label: '找一找' },
        { expression: 'tired', label: '爬升' },
        { expression: 'hydrate', label: '补水' },
        { expression: 'pr', label: '个人最好' },
        { expression: 'cheer', label: '完赛' },
        { expression: 'lost', label: '迷路' },
        { expression: 'sleep', label: '离线' },
      ] as const,
      principlesTitle: '三条底层原则',
      principles: [
        {
          icon: 'route',
          title: '固定版本，而不是浮动描述',
          body: '每条赛道绑定一个明确的赛事版本，记录距离口径、方向、高程口径与轨迹权利。没有可靠数字时显示“未知”，不用估算填空。',
        },
        {
          icon: 'book',
          title: '来源先于结论',
          body: '文章与工具的每条关键结论都要能回到公开来源或可复算的公式。来源记录支持的结论，而不是只放一个好看的外链。',
        },
        {
          icon: 'shield',
          title: '核验完成才发布',
          body: '中英文正文同时核验。健康与训练建议保持保守边界，不替代医生、教练或赛事官方信息。预览中的内容会明确标记为待核对。',
        },
      ],
      methodTitle: '内容如何生产',
      methodSteps: [
        '确定实体、版本与读者任务，先写清楚哪些问题不回答。',
        '查证官方赛事、公共机构或同行评议来源，记录可支持的结论。',
        '独立写作中英文正文，不使用旧版正文批量导入或机器扩写。',
        '运行结构、引用与双语校验；核对后绑定内容摘要哈希。',
        '发布后在复审到期或事实变化时重新核验，必要时撤回。',
      ],
      routesTitle: '路线与地图',
      routesBody: '地球只用于定位和空间语境。轨迹公开可见不等于允许再分发：只有许可明确的几何才可能进入本站；否则只显示锚点并链接官方资料，不绘制模拟轨迹。地图锚点不是起点或终点的精度声明。',
      knowledgeTitle: '知识与健康边界',
      knowledgeBody: '知识文章面向一般跑步人群，说明适用条件与不确定性。涉及疼痛、疾病、用药或极端环境时，我们只提供就医与求助方向，不给个体诊断。训练与营养建议不构成医疗建议。',
      toolsTitle: '工具与计算口径',
      toolsBody: '所有工具在浏览器本地计算，文件不上传。公式、输入范围、舍入规则和独立算例随工具一起公开。经验模型会标明适用距离与条件，不把预测写成保证，也不生成没有依据的安全排名。',
      licensesTitle: '许可与署名',
      licenses: [
        { label: '本站内容', value: 'CC BY 4.0，署名“跑起来 RUNUP”并链接原文；转载时注明是否修改。' },
        { label: '本站代码', value: 'MIT；各仓库的 LICENSE 文件为最终依据。' },
        { label: '赛道资料', value: '按各来源许可处理；本站不重新许可第三方轨迹、照片或赛事标识。' },
        { label: '卫星底图', value: 'NASA Earth Observatory Blue Marble Next Generation 影像合成，署名 NASA；按 NASA 媒体使用指南使用。' },
        { label: '路线近景', value: 'EOX Sentinel-2 cloudless 公开瓦片，署名 NASA / EOX，按 CC BY-NC-SA 4.0 使用。' },
        { label: '第三方依赖', value: 'Astro、CesiumJS、Pagefind 等按各自开源许可证使用。' },
      ],
      attributionTitle: '影像署名',
      attributionBody: '首页与路线页的卫星底图来自 NASA Earth Observatory 的 Blue Marble Next Generation 合成影像。它不是赛道几何，也不代表赛事官方地图。',
      statusTitle: '当前状态',
      statusBody: '站点已上线，当前发布 79 个内容实体：16 条路线、51 个知识实体（50 篇文章 + 术语表）和 12 项工具，中英文成对发布。预览构建会标记尚未完成核验的条目；生产构建只纳入已完成核验的内容。',
      correctionsTitle: '纠错与参与',
      correctionsBody: '发现事实、来源、计算、版权或商标问题时，请保留具体页面、版本与依据，通过 GitHub Issues 提交。我们会在核实后更正、补充说明或撤回内容。',
      correctionsFallback: '公开仓库暂不可用。上线前会补充可联系的仓库地址，不使用虚构邮箱或表单。',
      githubCta: '前往 GitHub Issues',
      backRoutes: '浏览路线',
      lastUpdated: '本页随构建更新',
      legalCta: '阅读法律、免责声明与许可',
    }
  : {
      title: 'About & method',
      lead: 'RunUp brings three things together: verifiable classic courses, traceable running knowledge and explainable calculators. Looking professional is not evidence.',
      mascotEyebrow: 'Meet Douke',
      mascotTitle: 'A bean that runs',
      mascotBody: 'Douke is the RunUp guide: a bean that runs. It does not train for you or decide for you; it appears at junctions, in articles and beside tools, with a face for the moment.',
      mascotExpressions: [
        { expression: 'run', label: 'On the move' },
        { expression: 'wave', label: 'Hello' },
        { expression: 'map', label: 'Route check' },
        { expression: 'book', label: 'Read a page' },
        { expression: 'tool', label: 'Number time' },
        { expression: 'search', label: 'Searching' },
        { expression: 'tired', label: 'Climbing' },
        { expression: 'hydrate', label: 'Hydrate' },
        { expression: 'pr', label: 'Personal best' },
        { expression: 'cheer', label: 'Finish' },
        { expression: 'lost', label: 'Lost' },
        { expression: 'sleep', label: 'Offline' },
      ] as const,
      principlesTitle: 'Three ground rules',
      principles: [
        {
          icon: 'route',
          title: 'A fixed version, not a moving description',
          body: 'Each course is tied to a specific event version and records its distance method, direction, elevation method and track rights. When a number is not reliable, we show “Unknown” instead of filling the gap with an estimate.',
        },
        {
          icon: 'book',
          title: 'Sources before conclusions',
          body: 'Every key claim in an article or tool must lead back to a public source or a reproducible formula. A source record names the claims it supports; a decorative link is not enough.',
        },
        {
          icon: 'shield',
          title: 'Publish only after review',
          body: 'Chinese and English text are checked together. Health and training guidance keeps conservative boundaries and never replaces a clinician, coach or official race information. Preview content is labelled as still being checked.',
        },
      ],
      methodTitle: 'How content is made',
      methodSteps: [
        'Define the entity, version and reader task, including the questions we will not answer.',
        'Verify official race, public-agency or peer-reviewed sources and record the claims they support.',
        'Write both language versions independently, without bulk-importing legacy text or padding.',
        'Run structural, citation and bilingual validation; bind a check record to a content digest.',
        'Re-check at the review due date or when facts change, and withdraw content when it can no longer be supported.',
      ],
      routesTitle: 'Courses and maps',
      routesBody: 'The globe provides location and spatial context, nothing more. A publicly visible track is not automatically redistributable: only geometry with clear permission can enter this site. Otherwise we show an anchor and link the official material, drawing no simulated route. A map anchor is not a precision claim about a start or finish line.',
      knowledgeTitle: 'Knowledge and health boundaries',
      knowledgeBody: 'Knowledge articles serve general runners and state their conditions and uncertainties. For pain, illness, medication or extreme environments we point toward clinical care and official guidance rather than offering a diagnosis. Training and nutrition material is not medical advice.',
      toolsTitle: 'Tools and calculation methods',
      toolsBody: 'Every tool calculates locally in the browser and uploads no files. Formulas, input ranges, rounding rules and independent worked examples are published with the tool. Empirical models state their distance and conditions; predictions are not guarantees, and we do not invent safety rankings.',
      licensesTitle: 'Licences and attribution',
      licenses: [
        { label: 'Site content', value: 'CC BY 4.0. Credit “RUNUP 跑起来”, link to the original page and indicate changes.' },
        { label: 'Site code', value: 'MIT; the LICENSE file in each repository is authoritative.' },
        { label: 'Course material', value: 'Handled under each source’s licence. We do not relicense third-party tracks, photographs or race marks.' },
        { label: 'Satellite basemap', value: 'NASA Earth Observatory Blue Marble Next Generation composite, credited to NASA and used under NASA media guidelines.' },
        { label: 'Route close-ups', value: 'EOX Sentinel-2 cloudless public tiles, credited to NASA / EOX and used under CC BY-NC-SA 4.0.' },
        { label: 'Third-party software', value: 'Astro, CesiumJS, Pagefind and other dependencies remain under their own open-source licences.' },
      ],
      attributionTitle: 'Imagery credit',
      attributionBody: 'The satellite basemap on the home and route pages is a NASA Earth Observatory Blue Marble Next Generation composite. It is not course geometry and is not an official race map.',
      statusTitle: 'Current state',
      statusBody: 'The site is live with 79 published entities: 16 routes, 51 knowledge entities (50 articles plus a glossary) and 12 tools, all paired in Chinese and English. Preview builds mark entries still being checked; production builds include only checked content.',
      correctionsTitle: 'Corrections and participation',
      correctionsBody: 'If a fact, source, calculation, copyright or trademark issue is wrong, include the specific page, version and evidence and open a GitHub Issue. We will correct, annotate or withdraw content after checking it.',
      correctionsFallback: 'The public repository is temporarily unavailable. A contactable repository address will be provided; we do not invent an email or form.',
      githubCta: 'Open GitHub Issues',
      backRoutes: 'Browse routes',
      lastUpdated: 'Updated with each build',
      legalCta: 'Read legal, disclaimers and licences',
    };
const title = `${copy.title} · RUNUP`;
const description = locale === 'zh-CN'
  ? '跑起来的来源、核验、许可、地图与健康边界说明。'
  : 'RUNUP’s method for sources, review, licences, maps and health boundaries.';
---

<BaseLayout locale={locale} title={title} description={description} active="routes" preview={content.preview}>
  <div class="page-shell narrow">
    <div class="breadcrumbs">
      <ol>
        <li><a href={`${prefix}/`}>{t(locale, 'home')}</a></li>
        <li>{copy.title}</li>
      </ol>
    </div>

    <div class="page-intro about-intro">
      <div>
        <span class="pill mint"><Icon name="compass" size={14} />{locale === 'zh-CN' ? '项目说明' : 'Project note'}</span>
        <h1>{copy.title}</h1>
        <p>{copy.lead}</p>
      </div>
    </div>

    <section class="about-mascot" aria-labelledby="mascot-title">
      <div>
        <span class="pill yellow"><Icon name="spark" size={14} />{copy.mascotEyebrow}</span>
        <h2 id="mascot-title">{copy.mascotTitle}</h2>
        <p>{copy.mascotBody}</p>
      </div>
      <div class="mascot-grid">
        {copy.mascotExpressions.map((item) => (
          <figure class="mascot-card">
            <Bean expression={item.expression} size={56} />
            <figcaption>{item.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <div class="section-heading"><h2>{copy.principlesTitle}</h2></div>
    <div class="grid three about-principles">
      {copy.principles.map((principle) => (
        <article class="card pad">
          <span class="about-icon"><Icon name={principle.icon} size={24} /></span>
          <h3>{principle.title}</h3>
          <p>{principle.body}</p>
        </article>
      ))}
    </div>

    <section class="about-section" aria-labelledby="method-title">
      <div class="section-heading"><h2 id="method-title">{copy.methodTitle}</h2></div>
      <ol class="about-steps">
        {copy.methodSteps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <div class="grid two about-sections">
      <section class="card pad about-block">
        <span class="pill blue"><Icon name="globe" size={14} />{copy.routesTitle}</span>
        <p>{copy.routesBody}</p>
      </section>
      <section class="card pad about-block">
        <span class="pill lavender"><Icon name="book" size={14} />{copy.knowledgeTitle}</span>
        <p>{copy.knowledgeBody}</p>
      </section>
      <section class="card pad about-block">
        <span class="pill yellow"><Icon name="tools" size={14} />{copy.toolsTitle}</span>
        <p>{copy.toolsBody}</p>
      </section>
      <section class="card pad about-block">
        <span class="pill coral"><Icon name="shield" size={14} />{copy.statusTitle}</span>
        <p>{copy.statusBody}</p>
      </section>
    </div>

    <section class="about-section" id="licenses" aria-labelledby="licenses-title">
      <div class="section-heading"><h2 id="licenses-title">{copy.licensesTitle}</h2></div>
      <dl class="license-list">
        {copy.licenses.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
      <p class="license-legal-link"><a href={`${prefix}/legal/`}>{copy.legalCta}</a></p>
    </section>

    <section class="about-section" id="attribution" aria-labelledby="attribution-title">
      <div class="section-heading"><h2 id="attribution-title">{copy.attributionTitle}</h2></div>
      <div class="notice tone-blue">
        <Icon name="globe" size={19} />
        <div>
          <p>{copy.attributionBody}</p>
          <a href="https://science.nasa.gov/earth/earth-observatory/blue-marble-next-generation/" rel="external noopener">
            NASA Earth Observatory · Blue Marble Next Generation <Icon name="external" size={14} />
          </a>
        </div>
      </div>
    </section>

    <section class="about-section" id="corrections" aria-labelledby="corrections-title">
      <div class="section-heading"><h2 id="corrections-title">{copy.correctionsTitle}</h2></div>
      <p>{copy.correctionsBody}</p>
      {gh ? (
        <a class="button primary" href={`${gh}/issues`} rel="external noopener">
          <Icon name="github" size={17} />{copy.githubCta}
        </a>
      ) : (
        <div class="notice">
          <Icon name="info" size={18} />
          <p>{copy.correctionsFallback}</p>
        </div>
      )}
    </section>

    <div class="about-footer-actions">
      <a class="button primary" href={`${prefix}/routes/`}><Icon name="route" size={17} />{copy.backRoutes}</a>
      <span class="field-hint">{copy.lastUpdated} · {new Date().getUTCFullYear()}</span>
    </div>
  </div>
</BaseLayout>

<style>
  .about-intro {
    margin-bottom: 8px;
  }

  .about-intro h1 {
    margin-top: 14px;
  }

  .about-principles {
    align-items: stretch;
  }

  .about-mascot {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 28px;
    align-items: center;
    margin: 26px 0 8px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--surface-2);
  }

  .about-mascot h2 {
    margin: 12px 0 8px;
    font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.8rem);
  }

  .about-mascot p {
    margin: 0;
    color: var(--muted);
    line-height: 1.72;
  }

  .mascot-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }

  .mascot-card {
    display: grid;
    justify-items: center;
    gap: 2px;
    margin: 0;
    padding: 8px 4px 7px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .mascot-card svg {
    width: 54px;
    height: 54px;
  }

  .mascot-card figcaption {
    color: var(--muted-strong);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
  }

  .about-principles .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .about-principles h3 {
    margin: 2px 0 0;
    font-size: 1.12rem;
  }

  .about-principles p,
  .about-block p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .about-icon {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--primary-soft);
    color: var(--primary-text);
  }

  .about-section {
    margin-top: 48px;
  }

  .license-legal-link {
    margin-top: 14px;
  }

  .license-legal-link a {
    color: var(--muted-strong);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-sections {
    margin-top: 18px;
  }

  .about-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-block .pill {
    align-self: flex-start;
  }

  .about-steps {
    display: grid;
    gap: 10px;
    max-width: 820px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: about-step;
  }

  .about-steps li {
    display: flex;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-input);
    background: var(--surface);
    color: var(--muted-strong);
    font-size: 0.92rem;
    counter-increment: about-step;
  }

  .about-steps li::before {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary-text);
    content: counter(about-step);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .license-list {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .license-list div {
    display: grid;
    grid-template-columns: minmax(130px, 0.3fr) minmax(0, 1fr);
    gap: 18px;
    padding: 16px 2px;
    border-bottom: 1px solid var(--border);
  }

  .license-list dt {
    color: var(--text);
    font-weight: 750;
    font-size: 0.9rem;
  }

  .license-list dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .about-footer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 46px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .field-hint {
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 900px) {
    .mascot-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .about-mascot {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 20px;
    }

    .mascot-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .license-list div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
