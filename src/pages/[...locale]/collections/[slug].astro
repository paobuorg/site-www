---
import BaseLayout from '@paobu/core/layouts/BaseLayout.astro';
import Icon from '@paobu/core/components/Icon.astro';
import { t, type Locale, LOCALES } from '@paobu/core/lib/i18n';
import { localePrefix, localeStaticParam } from '@paobu/core/lib/routing';
import { siteContent } from '../../../lib/content';
import { formatDistance, formatElevation, routeDetails, routeTypeLabel } from '../../../lib/view';
import { ROUTE_COLLECTIONS, routeCollection } from '../../../lib/collections';

export function getStaticPaths() {
  const content = siteContent();
  const visible = new Set(content.visible('route').map((entity) => entity.slug));
  return LOCALES.flatMap((locale) => ROUTE_COLLECTIONS.map((collection) => ({
    params: { locale: localeStaticParam(locale), slug: collection.slug },
    props: { locale, collectionSlug: collection.slug, slugs: collection.routes.filter((slug) => visible.has(slug)) },
  })));
}

const locale = Astro.props.locale as Locale;
const prefix = localePrefix(locale);
const content = siteContent();
const collection = routeCollection(Astro.props.collectionSlug);
if (!collection) throw new Error(`Unknown collection ${Astro.props.collectionSlug}`);
const text = collection[locale === 'zh-CN' ? 'zh' : 'en'];
const slugs = Astro.props.slugs as string[];
const routes = slugs.map((slug) => content.visible('route').find((entity) => entity.slug === slug)).filter(Boolean);
const others = ROUTE_COLLECTIONS.filter((item) => item.slug !== collection.slug).slice(0, 3);
const copy = locale === 'zh-CN'
  ? { home: '首页', all: '全部路线', collections: '主题集合', count: '条路线', notes: '读这一组时先看什么', others: '换一个集合', open: '打开路线', version: '版本', elevation: '爬升' }
  : { home: 'Home', all: 'All routes', collections: 'Collections', count: 'routes', notes: 'What to read first in this group', others: 'Try another collection', open: 'Open route', version: 'Version', elevation: 'Gain' };
const pageTitle = `${text.title} · RUNUP`;
---
<BaseLayout locale={locale} title={pageTitle} description={text.summary} active="routes" preview={content.preview} footerAd>
  <div class="page-shell">
    <div class="breadcrumbs"><ol><li><a href={`${prefix}/`}>{copy.home}</a></li><li><a href={`${prefix}/routes/`}>{copy.all}</a></li><li><a href={`${prefix}/collections/`}>{copy.collections}</a></li><li>{text.title}</li></ol></div>
    <div class="page-intro"><div><span class="pill mint"><Icon name={collection.icon} size={14} />{routes.length} {copy.count}</span><h1>{text.title}</h1><p>{text.intro}</p></div></div>
    <section class="collection-notes">
      <h2>{copy.notes}</h2>
      <ul>{text.notes.map((note) => <li>{note}</li>)}</ul>
    </section>
    <div class="route-collection-list">
      {routes.map((route) => {
        const details = routeDetails(route!);
        const translation = content.translation(route!, locale);
        return (
          <a class="card route-collection-item" href={`${prefix}/routes/${route!.slug}/`}>
            <div>
              <span class="pill">{routeTypeLabel(details.raceType, locale)}</span>
              <h3>{translation.title}</h3>
              <p>{details.placeName[locale]}</p>
            </div>
            <div class="route-collection-meta">
              <span>{formatDistance(details.distanceMeters, locale)}</span>
              <span>{copy.elevation} {formatElevation(details.elevationGainMeters, locale)}</span>
              <span>{copy.version} {details.courseEdition}</span>
            </div>
          </a>
        );
      })}
    </div>
    <section class="collection-others">
      <h2>{copy.others}</h2>
      <div class="related-row">
        {others.map((item) => <a class="related-link" href={`${prefix}/collections/${item.slug}/`}><span>{item[locale === 'zh-CN' ? 'zh' : 'en'].title}</span><Icon name="arrow-right" size={17} /></a>)}
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .collection-card { display: grid; gap: 8px; padding: 24px; color: var(--text); text-decoration: none; }
  .collection-card h2 { margin: 0; font-size: 1.25rem; }
  .collection-card p { margin: 0; color: var(--muted); line-height: 1.65; }
  .collection-open { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-weight: 750; color: var(--primary-strong, var(--text)); }
  .collection-notes { margin: 0 0 28px; padding: 22px 24px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--surface-2); }
  .collection-notes h2 { margin: 0 0 10px; font-size: 1.1rem; }
  .collection-notes ul { margin: 0; padding-left: 20px; color: var(--muted-strong); line-height: 1.8; }
  .route-collection-list { display: grid; gap: 12px; }
  .route-collection-item { display: flex; justify-content: space-between; gap: 20px; padding: 20px; color: var(--text); text-decoration: none; }
  .route-collection-item h3 { margin: 8px 0 4px; }
  .route-collection-item p { margin: 0; color: var(--muted); }
  .route-collection-meta { display: grid; gap: 4px; flex: 0 0 auto; text-align: right; color: var(--muted); font-size: 0.8rem; }
  .collection-others { margin-top: 36px; }
  @media (max-width: 640px) { .route-collection-item { display: grid; } .route-collection-meta { text-align: left; } }
</style>
