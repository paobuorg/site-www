---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FooterAd from '../components/FooterAd.astro';
import BottomNav from '../components/BottomNav.astro';
import Icon from '../components/Icon.astro';
import { t, isLocale, type Locale, type SiteKind } from '../lib/i18n';
import { alternateLocalePath } from '../lib/routing';
import { siteOrigin } from '../lib/sites';
import { preferenceInitScript, themeToggleScript, localeSwitchScript, viewportAssistScript } from '../lib/preferences';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  active: SiteKind;
  alternateHref?: string;
  preview?: boolean;
  noindex?: boolean;
  bodyClass?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  footerAd?: boolean;
  modifiedTime?: string | null;
}
const {
  locale,
  title,
  description,
  active,
  alternateHref,
  preview = false,
  noindex = false,
  bodyClass = '',
  ogType = 'website',
  structuredData,
  footerAd = false,
  modifiedTime = null,
} = Astro.props;
const pathname = Astro.url.pathname;
const other = locale === 'zh-CN' ? 'en' : 'zh-CN';
const origin = Astro.site ?? Astro.url.origin;
const altHref = alternateHref ?? alternateLocalePath(pathname, other);
const canonical = new URL(pathname, origin).toString();
const alternateCanonical = new URL(alternateLocalePath(pathname, other), origin).toString();
const defaultCanonical = new URL(alternateLocalePath(pathname, 'zh-CN'), origin).toString();
const fullTitle = title.includes('RUNUP') || title.includes('跑起来') ? title : `${title} · 跑起来 RUNUP`;
const otherLocale: Locale = other;
const alternateLabel = isLocale(otherLocale) ? otherLocale : 'en';
const adsenseClient = (import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined)?.trim();
const socialImage = new URL('/social-card.png', origin).toString();
const siteRoot = siteOrigin(active);
const siteHome = new URL(locale === 'zh-CN' ? '/' : '/en/', siteRoot).toString();
const organizationId = `${siteRoot}/#organization`;
const websiteId = `${siteRoot}/#website`;
const searchUrl = new URL(locale === 'zh-CN' ? '/search/' : '/en/search/', siteRoot).toString();
const organizationData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: 'RUNUP',
  alternateName: '跑起来',
  url: `${siteRoot}/`,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/icon-512.png', siteRoot).toString(),
    width: 512,
    height: 512,
  },
  sameAs: ['https://github.com/paobuorg'],
};
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: 'RUNUP',
  alternateName: '跑起来',
  url: siteHome,
  inLanguage: locale,
  publisher: { '@id': organizationId },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${searchUrl}?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
const structuredItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const structuredJson = JSON.stringify([organizationData, websiteData, ...structuredItems]).replaceAll(
  '<',
  '\\u003c',
);
const robotsContent =
  noindex || preview
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const serviceWorkerScript = String.raw`
(function () {
  if (!('serviceWorker' in navigator)) return;
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js').catch(function () {});
  });
})();
`;
---
<!doctype html>
<html lang={locale === 'zh-CN' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={preferenceInitScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="跑起来 RUNUP" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLabel} href={alternateCanonical} />
    <link rel="alternate" hreflang="x-default" href={defaultCanonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="RUNUP" />
    <meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh-CN' ? 'en_US' : 'zh_CN'} />
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={locale === 'zh-CN' ? '跑起来 RUNUP：经典赛道、跑步知识与计算工具' : 'RUNUP: classic courses, running knowledge and calculators'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={structuredJson} />
    <meta name="theme-color" content="#08B89D" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="apple-mobile-web-app-title" content="跑起来" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {adsenseClient && <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />}
    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}
    {adsenseClient && !preview && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{t(locale, 'skip')}</a>
    <Header locale={locale} active={active} alternateHref={altHref} />
    {preview && (
      <div class="preview-banner" role="note">
        <Icon name="alert" size={16} />
        <span>{t(locale, 'previewBanner')}</span>
      </div>
    )}
    <main id="main-content" class="site-main">
      <slot />
    </main>
    {footerAd && !preview && <FooterAd locale={locale} />}
    <Footer locale={locale} active={active} />
    <BottomNav locale={locale} active={active} />
    <script is:inline set:html={themeToggleScript(locale)} />
    <script is:inline set:html={localeSwitchScript(other)} />
    <script is:inline set:html={viewportAssistScript} />
    {!preview && <script is:inline set:html={serviceWorkerScript} />}
    <slot name="scripts" />
  </body>
</html>
