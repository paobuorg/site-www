---
import Icon from './Icon.astro';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  locale: Locale;
  action: string;
  value?: string;
  placeholder?: string;
  id?: string;
}
const { locale, action, value = '', placeholder, id = 'site-search' } = Astro.props;
---
<form class="search-field" role="search" action={action} method="get">
  <Icon name="search" size={19} />
  <label class="sr-only" for={id}>{t(locale, 'search')}</label>
  <input
    id={id}
    type="search"
    name="q"
    value={value}
    placeholder={placeholder ?? t(locale, 'searchPlaceholder')}
    autocomplete="off"
    spellcheck="false"
  />
  <button type="submit" aria-label={t(locale, 'search')}>
    <Icon name="search" size={17} />
  </button>
</form>
