---
import { nextBeanGradientId } from '../lib/bean';

type Expression =
  | 'neutral'
  | 'run'
  | 'cheer'
  | 'tired'
  | 'hydrate'
  | 'pr'
  | 'lost'
  | 'wave'
  | 'map'
  | 'book'
  | 'tool'
  | 'search'
  | 'sleep';

interface Props {
  expression?: Expression;
  size?: number;
  className?: string;
  label?: string;
}
const { expression = 'neutral', size = 96, className = '', label } = Astro.props;
const accessible = typeof label === 'string' && label.length > 0;
const gradientId = nextBeanGradientId();
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 96 96"
  role={accessible ? 'img' : undefined}
  aria-label={accessible ? label : undefined}
  aria-hidden={accessible ? undefined : 'true'}
>
  <defs>
    <linearGradient id={gradientId} x1="18" y1="16" x2="78" y2="82" gradientUnits="userSpaceOnUse">
      <stop stop-color="#45E0BF"></stop>
      <stop offset="0.55" stop-color="#08B89D"></stop>
      <stop offset="1" stop-color="#1761A8"></stop>
    </linearGradient>
  </defs>
  <circle cx="48" cy="48" r="44" fill="#E8FAF4"></circle>
  <path
    d="M48 13C67 13 81 28 80 47c-1 21-15 35-33 34C29 80 16 66 17 47 18 28 31 13 48 13Z"
    fill={`url(#${gradientId})`}
    stroke="#074C44"
    stroke-width="2.8"
  ></path>
  <path
    d="M22 46C33 33 41 39 48 30C53 24 60 26 66 21"
    fill="none"
    stroke="#F8FFFC"
    stroke-width="5.2"
    stroke-linecap="round"
  ></path>
  <circle cx="22" cy="46" r="3.6" fill="#F56765" stroke="#F8FFFC" stroke-width="1.4"></circle>

  {expression === 'neutral' && (
    <>
      <circle cx="39" cy="56" r="3.1" fill="#074C44"></circle>
      <circle cx="58" cy="56" r="3.1" fill="#074C44"></circle>
      <path d="M43 65c3 2.4 7 2.4 10 0" fill="none" stroke="#074C44" stroke-width="2.2" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'run' && (
    <>
      <path d="M36 56l6 2M61 56l-6 2" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M42 64c4 5 8 5 12 0" fill="none" stroke="#074C44" stroke-width="2.8" stroke-linecap="round"></path>
      <path d="M8 43h7M7 53h8M8 63l7 2" fill="none" stroke="#F56765" stroke-width="3" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'cheer' && (
    <>
      <path d="M35 57c3-4 7-4 10 0M52 57c3-4 7-4 10 0" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M41 63c4 6 10 6 14 0" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M74 36l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z" fill="#FFD65A"></path>
    </>
  )}

  {expression === 'tired' && (
    <>
      <path d="M34 57h9M53 57h9" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M43 66c3 2 7 2 10 0" fill="none" stroke="#074C44" stroke-width="2.2" stroke-linecap="round"></path>
      <path d="M73 38c3 4 5 7 5 9a5 5 0 0 1-10 0c0-2 2-5 5-9Z" fill="#8FD6F7" stroke="#173A6B" stroke-width="1.6"></path>
    </>
  )}

  {expression === 'hydrate' && (
    <>
      <circle cx="39" cy="56" r="3.1" fill="#074C44"></circle>
      <circle cx="58" cy="56" r="3.1" fill="#074C44"></circle>
      <path d="M43 65c3 2.6 7 2.6 10 0" fill="none" stroke="#074C44" stroke-width="2.2" stroke-linecap="round"></path>
      <path d="M75 52h4v6h-4Z" fill="#8FD6F7" stroke="#173A6B" stroke-width="1.6"></path>
      <path d="M73 58h8v16a4 4 0 0 1-8 0Z" fill="#8FD6F7" stroke="#173A6B" stroke-width="1.6"></path>
      <path d="M75 66h4" fill="none" stroke="#F8FFFC" stroke-width="2" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'pr' && (
    <>
      <path d="M35 57c3-4 7-4 10 0M52 57c3-4 7-4 10 0" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M41 63c4 6 10 6 14 0" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M44 68l1 4M52 68l-1 4" fill="none" stroke="#A06A00" stroke-width="2.2" stroke-linecap="round"></path>
      <circle cx="48" cy="76" r="6.5" fill="#FFD65A" stroke="#A06A00" stroke-width="1.8"></circle>
      <path d="M45 76l2 2 4-5" fill="none" stroke="#A06A00" stroke-width="1.7" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'lost' && (
    <>
      <path d="M35 56c3-3 6 3 9 0M52 56c3-3 6 3 9 0" fill="none" stroke="#074C44" stroke-width="2.5" stroke-linecap="round"></path>
      <path d="M43 66h10" fill="none" stroke="#074C44" stroke-width="2.3" stroke-linecap="round"></path>
      <path d="M72 39c0-4 3-7 7-7s7 3 7 7c0 3-3 4-5 6l-1 2" fill="none" stroke="#173A6B" stroke-width="2.6" stroke-linecap="round"></path>
      <circle cx="80" cy="52" r="2.2" fill="#173A6B"></circle>
    </>
  )}

  {expression === 'wave' && (
    <>
      <circle cx="39" cy="56" r="3.1" fill="#074C44"></circle>
      <path d="M52 57c3-4 7-4 10 0" fill="none" stroke="#074C44" stroke-width="3" stroke-linecap="round"></path>
      <path d="M42 64c4 5 9 5 13 0" fill="none" stroke="#074C44" stroke-width="2.6" stroke-linecap="round"></path>
      <path d="M78 55c3 2 3 6 0 8M82 50c5 4 5 12 0 16" fill="none" stroke="#F56765" stroke-width="2.4" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'map' && (
    <>
      <circle cx="39" cy="57" r="3.1" fill="#074C44"></circle>
      <circle cx="58" cy="57" r="3.1" fill="#074C44"></circle>
      <path d="M30 69l11-4 11 4 11-4v8l-11 4-11-4-11 4Z" fill="#FFF8E8" stroke="#173A6B" stroke-width="1.8" stroke-linejoin="round"></path>
      <path d="M41 65v8M52 69v8M63 65v8" fill="none" stroke="#173A6B" stroke-width="1.3"></path>
      <path d="M35 72c3-2 6-2 9 0" fill="none" stroke="#F56765" stroke-width="1.6" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'book' && (
    <>
      <circle cx="39" cy="57" r="3.1" fill="#074C44"></circle>
      <circle cx="58" cy="57" r="3.1" fill="#074C44"></circle>
      <path d="M28 69c6-3 13-3 20 0 7-3 14-3 20 0v9c-6-3-13-3-20 0-7-3-14-3-20 0Z" fill="#FFFDF4" stroke="#173A6B" stroke-width="1.8" stroke-linejoin="round"></path>
      <path d="M48 69v9M32 71c4-1 8-1 12 0M52 71c4-1 8-1 12 0" fill="none" stroke="#173A6B" stroke-width="1.2" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'tool' && (
    <>
      <circle cx="39" cy="56" r="3.1" fill="#074C44"></circle>
      <circle cx="58" cy="56" r="3.1" fill="#074C44"></circle>
      <path d="M43 65c3 2.4 7 2.4 10 0" fill="none" stroke="#074C44" stroke-width="2.2" stroke-linecap="round"></path>
      <path d="M80 62a8 8 0 0 0-9 10l-4 4a3 3 0 0 0 4 4l4-4a8 8 0 0 0 10-9l-4 4-4-4Z" fill="#FFD65A" stroke="#A06A00" stroke-width="1.6" stroke-linejoin="round"></path>
    </>
  )}

  {expression === 'search' && (
    <>
      <circle cx="39" cy="56" r="3.1" fill="#074C44"></circle>
      <path d="M43 65c3 2.4 7 2.4 10 0" fill="none" stroke="#074C44" stroke-width="2.2" stroke-linecap="round"></path>
      <circle cx="60" cy="56" r="10" fill="#E8FAF4" fill-opacity="0.72" stroke="#173A6B" stroke-width="2.4"></circle>
      <circle cx="60" cy="56" r="2.7" fill="#074C44"></circle>
      <path d="M67.5 63.5L76 72" fill="none" stroke="#173A6B" stroke-width="4" stroke-linecap="round"></path>
    </>
  )}

  {expression === 'sleep' && (
    <>
      <path d="M35 56c3 3 6 3 9 0M52 56c3 3 6 3 9 0" fill="none" stroke="#074C44" stroke-width="2.8" stroke-linecap="round"></path>
      <path d="M45 65h6" fill="none" stroke="#074C44" stroke-width="2.2" stroke-linecap="round"></path>
      <path d="M73 32h7l-7 8h7M82 43h5l-5 6h5" fill="none" stroke="#173A6B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
    </>
  )}
</svg>
