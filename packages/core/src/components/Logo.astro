---
import Bean from './Bean.astro';

interface Props {
  href: string;
  compact?: boolean;
}
const { href, compact = false } = Astro.props;
---
<a class="brand" href={href} aria-label="跑起来 RUNUP">
  <Bean expression="run" size={48} className="brand-mark" />
  {!compact && (
    <span class="brand-text">
      <span class="brand-cn">跑起来</span>
      <span class="brand-en">RUNUP</span>
    </span>
  )}
</a>
