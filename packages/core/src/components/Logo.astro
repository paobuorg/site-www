---
interface Props {
  href: string;
  compact?: boolean;
}
const { href, compact = false } = Astro.props;
---
<a class="brand" href={href} aria-label="跑地图 RunMap">
  <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
    <defs>
      <linearGradient id="brand-gradient" x1="8" y1="5" x2="41" y2="44" gradientUnits="userSpaceOnUse">
        <stop stop-color="#45E0BF"></stop>
        <stop offset="0.58" stop-color="#08B89D"></stop>
        <stop offset="1" stop-color="#1761A8"></stop>
      </linearGradient>
    </defs>
    <circle cx="24" cy="24" r="22" fill="url(#brand-gradient)"></circle>
    <path d="M10 28.5c4.4-8.4 8.7-8.4 13 0s9.2 3.4 15-6" fill="none" stroke="#F8FFFC" stroke-width="3.5" stroke-linecap="round"></path>
    <circle cx="15" cy="17.5" r="3.2" fill="#F8FFFC" opacity="0.94"></circle>
    <path d="M29.5 15.5 37 22" stroke="#F8FFFC" stroke-width="2.4" stroke-linecap="round" opacity="0.72"></path>
  </svg>
  {!compact && (
    <span class="brand-text">
      <span class="brand-cn">跑地图</span>
      <span class="brand-en">RUNMAP</span>
    </span>
  )}
</a>
